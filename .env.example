# Copy to .env and adjust. Every setting uses the PROVENA_ prefix.
PROVENA_ENV=development            # development | test | production
PROVENA_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
PROVENA_LOG_FORMAT=console         # console | json (json is required in production)
PROVENA_HOST=0.0.0.0
PROVENA_PORT=8000
PROVENA_QDRANT_URL=http://localhost:6333
PROVENA_QDRANT_API_KEY=
PROVENA_PROBE_TIMEOUT_S=2.0
